<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>innate_console</name>
  <version>0.1.0</version>
  <description>Lightweight bridge that streams tmux pane stdout and /rosout to the webapp over rosbridge, with on-request backfill.</description>
  <maintainer email="eng@innate.bot">Innate Engineering</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
