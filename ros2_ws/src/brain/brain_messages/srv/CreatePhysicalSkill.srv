# Create a new physical skill directory with metadata.json
# Request
string name               # Display name for the skill (e.g. "Pick Up Socks")
string kind               # Intended final type: "learned" (default if empty), "replay",
                          # or "eval" (a rollout-capture dataset, never trained)
---
# Response
bool success
string message
string skill_directory     # Absolute path to the created skill directory
string skill_id            # Deterministic skill ID (e.g. "local/pick-up-socks")
