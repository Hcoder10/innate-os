# Convert a recorded teleop episode into a deterministic replay ("mimic") skill.
# Request
string task_directory     # Absolute path of the scratch task dir holding the recording (under data/)
string name               # Display name for the replay skill (e.g. "Wave hello")
string guidelines         # Optional: when the agent should use this skill (its LLM hint)
int32 episode_id          # Episode to convert (usually 0)
---
# Response
bool success
string message
string skill_directory    # Absolute path to the created replay-skill directory
string skill_id           # Deterministic skill ID (e.g. "local/wave-hello")
bool wheeled              # True if the base moved during the recording (else arm-only)
