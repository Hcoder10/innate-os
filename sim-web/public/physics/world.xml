<mujoco model="innate_sim">
  <!-- Combined physics world for sim-web: static apartment collision geometry
       (from obj2mjcf, see sim-web/assets/apartment_collisions/) plus a
       free-floating box standing in for the MARS base, driven by an applied
       force/torque velocity servo (no wheel modeling yet -- see
       src/physics/worker.ts). Generated file; regenerate rather than
       hand-edit the mesh/geom lists if apartment_collisions/ changes. -->

  <option timestep="0.005" gravity="0 0 -9.81"/>

  <!-- TEMPORARY: the apartment's obj2mjcf/CoACD-decomposed collision mesh
       turned out to be the actual bug (see sim-mujoco/ for the regeneration
       work in progress) -- pieces merge disconnected geometry into hulls
       that don't correspond to any real surface, so the robot can spawn on
       top of "furniture" that isn't there or catch a corner on a hull edge
       and spin out. Disabled (contype/conaffinity 0) rather than deleted so
       it's a one-line revert once the mesh is regenerated. A flat ground
       plane stands in below so the robot still has floor support for
       driving/teleop in the meantime -- it will clip through walls and
       furniture until the real collision mesh is back. -->
  <default>
    <default class="collision">
      <geom group="3" type="mesh" friction="0.9 0.01 0.001" condim="6" margin="0.03" solref="0.01 1"
            contype="0" conaffinity="0"/>
    </default>
  </default>

