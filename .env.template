# Environment configuration.
#
# Secrets + environment-only settings live here. Tunable ROS parameters (driving speed,
# camera, TTS voice, …) and extra agent/skill dirs live in config/settings.yaml;
# simulator settings in sim/config.toml.

# --- Secrets ---
# INNATE_SERVICE_KEY (hosted brain mode) is written to your local .env by
# `./innate setup` / `./innate-sim setup` and seeded to /etc/innate.env on update —
# it is never kept as a line in this template.
#
# GEMINI_API_KEY is required only when running the local brain in the sim
# (COMPOSE_PROFILES=local-brain) — the in-compose cloud-agent reads it from here.
# GEMINI_API_KEY=

# --- Cloud endpoints (all read from the environment; set by default) ---
# BRAIN_WEBSOCKET_URI=wss://agent-v1.innate.bot
# TELEMETRY_URL=https://logs-v1.innate.bot
# UNINAVID_WS_URL=wss://nav-v1.innate.bot
# INNATE_PROXY_URL=https://proxy-v1.innate.bot
# INNATE_AUTH_URL=https://auth-v1.innate.bot
# INNATE_TRAINING_URL=https://training-v1.innate.bot
