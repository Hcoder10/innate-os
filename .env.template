# Machine-local: secrets + a few environment overrides.
# Non-secret robot tunables (brain URI, telemetry, voice, ...) now live in
#   ros2_ws/src/innate_config/config/overrides.yaml
# Simulator settings stay in sim/config.toml.

# Filled by `./innate setup` / `./innate sim setup` when you use hosted brain mode.
INNATE_SERVICE_KEY=

# Extra directories to scan for agents/skills, in addition to workspace/.
# Absolute paths, os.pathsep-separated (":" on Linux). Moved here from the
# retired config/os.toml [paths] section.
# INNATE_EXTRA_AGENT_DIRS=/home/me/my-agents:/opt/team/agents
# INNATE_EXTRA_SKILL_DIRS=/home/me/my-skills

# set by default
# INNATE_PROXY_URL=https://proxy-v1.innate.bot
