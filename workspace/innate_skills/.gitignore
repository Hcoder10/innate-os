.env.*

# Recording-folder __init__.py shims are generated by the running robot
# (brain_client/skills/physical_refs.py) on every roster publish. They must
# never be tracked: a robot writes them before its checkout advances, and any
# tracked copy then aborts `git pull` / `innate update` with "untracked
# working tree files would be overwritten". This deliberately also catches a
# hand-written __init__.py in a code subpackage (arm/, chess/, ...) — those
# are rare and deliberate, `git add -f` one if it must ship.
*/__init__.py
# the shim writer's atomic-write temp, left behind only by a mid-write crash
*/__init__.py.*.tmp
