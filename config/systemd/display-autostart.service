[Unit]
Description=Bring up the graphical session only when a display is connected
# Runs once multi-user is reached, by which point DRM connectors are probed.
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
# If any DRM connector reads "connected", pull up the full graphical stack
# (gdm + desktop). --no-block keeps this off the critical boot path; the doubled
# $$ escapes the $ so systemd passes it through to the shell verbatim.
ExecStart=/bin/sh -c 'for s in /sys/class/drm/*/status; do [ "$$(cat "$$s" 2>/dev/null)" = connected ] && exec systemctl --no-block start graphical.target; done; exit 0'

[Install]
WantedBy=multi-user.target
